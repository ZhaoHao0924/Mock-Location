<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.locationd.simulation</key>
    <true/>
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <!-- AGXDeviceUserClient and IOSurfaceRootUserClient are IOKit user client
         class names, not entitlement keys. As bare booleans they were inert:
         nothing in the kernel checks for an entitlement by those names, so GPU
         access was never actually granted and MTLCreateSystemDefaultDevice
         returned nil. They only grant access as values of this exception. -->
    <key>com.apple.security.exception.iokit-user-client-class</key>
    <array>
        <string>AGXDeviceUserClient</string>
        <string>IOSurfaceRootUserClient</string>
    </array>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.personal.mocklocation</string>
    </array>
</dict>
</plist>
